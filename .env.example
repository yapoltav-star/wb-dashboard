# Скопируй в .env локально (Cursor) и/или в Railway Variables.
# Не коммить реальные значения. Инструкция: docs/CURSOR-WB-OZON.md

WB_TOKEN=
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=

# Ozon Seller API (товары, остатки, заказы, финансы, отзывы)
OZON_CLIENT_ID=
OZON_API_KEY=

# Опционально: Ozon Performance API (реклама)
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Опционально: Google Sheets «Наш склад» (доступ «все у кого есть ссылка»)
OWN_WAREHOUSE_SHEET_ID=
OWN_WAREHOUSE_GID=

# Телеграм-бот к дашборду (только чтение). Инструкция: docs/TELEGRAM-BOT.md
# Без TELEGRAM_BOT_TOKEN бот просто не запускается, остальное работает как раньше.
TELEGRAM_BOT_TOKEN=
# Белый список chat_id через запятую. Пусто = бот отвечает только подсказкой со своим id.
TELEGRAM_ALLOWED_CHAT_IDS=
# Опционально: включает ответы на вопросы обычным текстом, а не только команды
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Team CRM — кнопки «Афине / Заире» на полках (прокачать полки)
# URL сервиса team-crm на Railway, без слэша в конце
CRM_API_URL=
# Тот же пароль, что WEB_PASSWORD у team-crm
CRM_PASSWORD=
