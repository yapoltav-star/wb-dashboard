# Скопируй в Railway Variables (не коммить реальные значения)

# Seller API: кабинет → Настройки → Seller API
OZON_CLIENT_ID=
OZON_API_KEY=

# Performance API (реклама): кабинет → API-ключи → вкладка Performance API
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Supabase (отдельный проект от WB-дашборда)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_KEY=

# Опционально: RU-прокси для витрины ozon.ru (цена на сайте)
# proxy.market → резидентские или «для Ozon», страна Россия
# Форматы:
#   http://user:pass@host:port
#   host:port:user:pass
#   socks5://user:pass@host:port
# OZON_CLIENT_PROXY=
# OZON_CLIENT_WORKERS=6
